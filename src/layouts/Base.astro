---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = 'Field notes from a junior penetration tester: web application and network lab work, written up step by step.',
  wide = false,
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Index' },
  { href: '/writeups/', label: 'Writeups' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1321" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <script is:inline>
      // Marks that scripting is available before first paint, so the reveal
      // styles only ever apply when something can actually un-hide content.
      document.documentElement.classList.add('has-js');

      // The TOC is a <details>. Open it on wide viewports; start it closed
      // on narrow ones, where the section list is noise before you ask for it.
      document.addEventListener('DOMContentLoaded', () => {
        if (window.matchMedia('(max-width: 34rem)').matches) {
          document.querySelectorAll('details.toc[open]').forEach((d) => d.removeAttribute('open'));
        }
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['shell', wide && 'shell--wide']}>
      <header class="masthead">
        <div class="masthead__row">
          <a class="masthead__name" href="/">Ahmed Abdalrhman &mdash; alzeaty</a>
          <nav class="masthead__nav" aria-label="Primary">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    item.href === '/'
                      ? path === '/' || path === ''
                        ? 'page'
                        : undefined
                      : path.startsWith(item.href)
                        ? 'page'
                        : undefined
                  }
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <span>Field notes &mdash; written up from self-directed lab work.</span>
        <span>Set in Newsreader and JetBrains Mono.</span>
      </footer>
    </div>

    <script>
      // One IntersectionObserver, once per element, transform + opacity only.
      // Under prefers-reduced-motion the CSS keeps everything visible, so
      // there is nothing to do here.
      const targets = document.querySelectorAll('.reveal');
      const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');

      if (targets.length && motion.matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
