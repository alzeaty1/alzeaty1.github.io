---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = 'Ahmed Abdalrhman documents the investigation behind web security findings, alongside the software he builds.',
  wide = false,
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Portfolio' },
  { href: '/writeups/', label: 'Investigations' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about', label: 'About' },
];
const pageUrl = Astro.site ? new URL(path, Astro.site).toString() : path;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d1321" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      document.documentElement.classList.add('has-js');
      document.addEventListener('DOMContentLoaded', () => {
        if (window.matchMedia('(max-width: 34rem)').matches) {
          document.querySelectorAll('details.toc[open]').forEach((details) => details.removeAttribute('open'));
        }
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class:list={['shell', wide && 'shell--wide']}>
      <header class="masthead">
        <div class="masthead__row">
          <a class="masthead__name" href="/" aria-label="Ahmed Abdalrhman — portfolio home">
            <span class="masthead__mark" aria-hidden="true">A.</span>
            <span>Ahmed Abdalrhman <span class="masthead__separator">/</span> ALZeaty</span>
          </a>
          <nav class="masthead__nav" aria-label="Primary navigation">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={
                    item.href === '/'
                      ? path === '/' || path === ''
                        ? 'page'
                        : undefined
                      : path.startsWith(item.href)
                        ? 'page'
                        : undefined
                  }
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="colophon">
        <span>Ahmed Abdalrhman <span aria-hidden="true">/</span> Portfolio</span>
        <a href="mailto:ahmedabdalrhman838@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
      </footer>
    </div>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('has-motion');
        const revealObserver = new IntersectionObserver((entries, observer) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        }, { threshold: 0.01, rootMargin: '0px 0px -36px 0px' });
        document.querySelectorAll('.notebook-section, .contact-close, .project-case, .about-body, .page-cover, .index-catalog, .appendix-index').forEach((element) => revealObserver.observe(element));
      }
    </script>
  </body>
</html>
