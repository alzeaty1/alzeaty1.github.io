---
import Base from '../../layouts/Base.astro';
import { loadWriteups } from '../../lib/entries';

const { standalone, appendices } = await loadWriteups();
---

<Base
  title="Writeups — Ahmed Abdalrhman"
  description="Ten lab writeups: web application and network exploitation notes, written up step by step."
>
  <h1>Writeups</h1>

  <p>
    {standalone.length} writeups from self-directed lab work, plus
    {appendices.length === 1 ? ' one appendix' : ` ${appendices.length} appendices`} kept with
    the writeup they belong to. Difficulty and vulnerability class are taken
    straight from the front matter of each file.
  </p>

  <ul class="entrylist">
    {
      standalone.map((entry, i) => (
        <li class="reveal">
          <a class="entry" href={`/writeups/${entry.id}/`}>
            <div class="entry__row">
              <span class="entry__index">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="entry__title">{entry.data.title}</h2>
            </div>
            <p class="entry__meta">
              {entry.data.platform ?? 'lab'} &middot; {entry.data.room} &middot; {entry.data.difficulty}
            </p>
            {entry.data.vulnClass && <p class="entry__classes">{entry.data.vulnClass}</p>}
          </a>
        </li>
      ))
    }
  </ul>

  <h2>Appendices</h2>
  <ul class="entrylist">
    {
      appendices.map((entry) => (
        <li class="reveal">
          <a class="entry" href={`/writeups/${entry.id}/`}>
            <div class="entry__row">
              <span class="entry__index">A1</span>
              <h3 class="entry__title">{entry.data.title}</h3>
            </div>
            <p class="entry__meta">Appendix &middot; belongs to the writeup it is linked from</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
