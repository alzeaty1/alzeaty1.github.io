---
import Base from '../../layouts/Base.astro';
import { loadWriteups } from '../../lib/entries';

const { standalone, appendices } = await loadWriteups();
---

<Base
  title="Investigations — Ahmed Abdalrhman | ALZeaty Portfolio"
  description="A library of self-directed security lab investigations, with the observation, testing, evidence, and reasoning kept in view."
  wide
>
  <header class="page-cover page-cover--index">
    <p class="eyebrow"><span class="eyebrow__tick" aria-hidden="true"></span> Investigation index</p>
    <h1>Follow the evidence.<br /><em>Keep the reasoning.</em></h1>
    <p class="page-cover__lede">These are records of self-directed TryHackMe and PortSwigger Academy lab work. They preserve the sequence of observations, tests, mistakes, and conclusions from each investigation.</p>
    <p class="record-count"><span>{standalone.length}</span> investigations <i>·</i> <span>{appendices.length}</span> related reference {appendices.length === 1 ? 'entry' : 'entries'}</p>
  </header>

  <section class="index-catalog" aria-labelledby="catalog-title">
    <h2 class="sr-only" id="catalog-title">All investigations</h2>
    <ol class="catalog-list">
      {
        standalone.map((entry, i) => (
          <li>
            <a class="catalog-entry" href={`/writeups/${entry.id}/`}>
              <span class="catalog-entry__number">{String(i + 1).padStart(2, '0')}</span>
              <span class="catalog-entry__content">
                <span class="catalog-entry__title">{entry.data.title}</span>
                <span class="catalog-entry__context">{entry.data.platform ?? 'Lab'} <i>·</i> {entry.data.room} <i>·</i> {entry.data.difficulty}</span>
                {entry.data.vulnClass && <span class="catalog-entry__topics">{entry.data.vulnClass}</span>}
              </span>
              <span class="catalog-entry__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  {appendices.length > 0 && (
    <section class="appendix-index" aria-labelledby="appendix-title">
      <div class="section-marker"><span>REF</span><span>RELATED NOTES</span></div>
      <h2 id="appendix-title">References kept<br /><em>with their investigation.</em></h2>
      <ul class="appendix-list">
        {
          appendices.map((entry) => (
            <li>
              <a href={`/writeups/${entry.id}/`}>
                <span>{entry.data.title}</span>
                <span class="appendix-list__meta">Appendix</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  )}
</Base>
