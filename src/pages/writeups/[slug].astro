---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { loadWriteups, appendicesFor, scriptsFor } from '../../lib/entries';

export async function getStaticPaths() {
  const { all } = await loadWriteups();
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Derived from the rendered headings — never hardcoded. Depth 2 only, so
// the TOC matches the writeup's own top-level structure.
const sections = headings.filter((h) => h.depth === 2);

const { all, appendices } = await loadWriteups();
const position = all.findIndex((e) => e.id === entry.id);
const prev = position > 0 ? all[position - 1] : undefined;
const next = position < all.length - 1 ? all[position + 1] : undefined;

const isAppendix = entry.data.appendix === true;
const parentSlug = (entry.data.parent ?? '').replace(/^\//, '');
const parent = all.find((e) => e.id === parentSlug);
const children = appendicesFor(entry.id, appendices);
const scripts = scriptsFor(entry.id);
---

<Base title={`${entry.data.title} — Ahmed Abdalrhman`} description={entry.data.vulnClass ?? entry.data.title} wide>
  <article>
    <header class="writeup__head">
      {
        isAppendix && parent && (
          <p class="entry__meta">
            Appendix to <a href={`/writeups/${parent.id}/`}>{parent.data.title}</a>
          </p>
        )
      }
      <h1>{entry.data.title}</h1>

      <dl class="metastrip">
        {
          !isAppendix && (
            <div>
              <dt>Room</dt>
              <dd>{entry.data.room}</dd>
            </div>
          )
        }
        {
          !isAppendix && (
            <div>
              <dt>Difficulty</dt>
              <dd>{entry.data.difficulty}</dd>
            </div>
          )
        }
        {
          entry.data.vulnClass && (
            <div>
              <dt>Class</dt>
              <dd>{entry.data.vulnClass}</dd>
            </div>
          )
        }
        {
          entry.data.dateSolved && (
            <div>
              <dt>Solved</dt>
              <dd>{entry.data.dateSolved.toISOString().slice(0, 10)}</dd>
            </div>
          )
        }
      </dl>
    </header>

    {
      sections.length > 1 && (
        <details class="toc" open>
          <summary class="toc__label">On this page</summary>
          <ul class="toc__list">
            {sections.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </details>
      )
    }

    <div class="prose">
      <Content />
    </div>

    <script>
      // The CSS already contains the overflow; this pass only reports it.
      // Boxes that actually scroll get the affordance and become focusable,
      // so a keyboard reader can pan them. Boxes that fit are left alone, so
      // short code spans never turn into tab stops.
      const boxes = Array.from(
        document.querySelectorAll('.prose__scroll'),
      );
      let anyScrollable = false;

      for (const box of boxes) {
        // 1px of slack: sub-pixel layout must not flip the affordance on.
        if (box.scrollWidth - box.clientWidth <= 1) continue;

        anyScrollable = true;
        box.classList.add('prose__scroll--is-scrollable');
        box.tabIndex = 0;
        box.setAttribute('role', 'group');
        box.setAttribute(
          'aria-label',
          box.classList.contains('prose__scroll--table')
            ? 'Table, scrolls sideways'
            : 'Code, scrolls sideways',
        );

        if (box.classList.contains('prose__scroll--table')) {
          const hint = document.createElement('p');
          hint.className = 'prose__scroll__hint';
          hint.textContent = '→ scroll sideways to see the rest of this table';
          hint.setAttribute('aria-hidden', 'true');
          box.append(hint);
        }
      }

      if (anyScrollable) {
        const note = document.createElement('p');
        note.className = 'prose__scroll-note';
        note.setAttribute('data-shown', '');
        note.innerHTML =
          'Wide tables and long code spans scroll sideways. ' +
          'They are kept on one line on purpose &mdash; nothing here is re-wrapped.';
        document.querySelector('.prose').append(note);
      }
    </script>

    {
      children.length > 0 && (
        <aside class="appendix-link">
          {children.length === 1 ? 'Appendix' : 'Appendices'}:{' '}
          {children.map((child, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/writeups/${child.id}/`}>{child.data.title}</a>
            </>
          ))}
        </aside>
      )
    }

    {
      scripts.length > 0 && (
        <section class="section">
          <p class="section__label">Scripts used</p>
          <ul class="scripts">
            {scripts.map((s) => (
              <li>
                <a class="filelink" href={s.href}>
                  {s.href}
                </a>{' '}
                &mdash; {s.note}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <nav class="pager" aria-label="Writeup navigation">
    {prev ? <a href={`/writeups/${prev.id}/`}>&larr; {prev.data.title}</a> : <span />}
    {next ? <a href={`/writeups/${next.id}/`}>{next.data.title} &rarr;</a> : <span />}
  </nav>
</Base>
